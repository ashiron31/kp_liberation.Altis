			class Attributes
			{
				init="this setVariable [""markerName"",  ""townCenter_Kavala"", true]; " \n "this setVariable [""lightRadius"", 600,               true]; " \n "this setVariable [""poweredOn"", true,  true]; " \n "" \n "this addAction [  " \n "    ""Turn Power On"",  " \n "    {  " \n "        params [""_target"",""_caller"",""_actionId"",""_args""];  " \n "        private _marker   = _target getVariable [""markerName"",""""];  " \n "        private _distance = _target getVariable [""lightRadius"",0];  " \n "        {  " \n "            private _ticket = format [""LSS%1"", _forEachIndex];  " \n "            [_x, ""On""] remoteExec [""switchLight"", 0, _ticket];  " \n "        } forEach nearestObjects [markerPos _marker, [], _distance];  " \n "        _target setVariable [""poweredOn"", true, true];  " \n "    },  " \n "    [],  " \n "    1.5,  " \n "    true,  " \n "    true,  " \n "    """",  " \n "    ""(_target getVariable ['poweredOn',false]) == false"",  " \n "    3,  " \n "    false,  " \n "    """",  " \n "    """"  " \n "];  " \n "  " \n "this addAction [  " \n "    ""Turn Power Off"",  " \n "    {  " \n "        params [""_target"",""_caller"",""_actionId"",""_args""];  " \n "        private _marker   = _target getVariable [""markerName"",""""];  " \n "        private _distance = _target getVariable [""lightRadius"",0];  " \n "        {  " \n "            private _ticket = format [""LSS%1"", _forEachIndex];  " \n "            [_x, ""OFF""] remoteExec [""switchLight"", 0, _ticket];  " \n "        } forEach nearestObjects [markerPos _marker, [], _distance];  " \n "        _target setVariable [""poweredOn"", false, true];  " \n "    },  " \n "    [],  " \n "    1.5,  " \n "    true,  " \n "    true,  " \n "    """",  " \n "    ""(_target getVariable ['poweredOn',false]) == true"",  " \n "    3,  " \n "    false,  " \n "    """",  " \n "    """"  " \n "];  " \n "  " \n "this addEventHandler [""Killed"", {  " \n "    params [""_unit"",""_killer"",""_proj""];  " \n "    private _marker   = _unit getVariable [""markerName"",""""];  " \n "    private _distance = _unit getVariable [""lightRadius"",0];  " \n "    {  " \n "        private _ticket = format [""LSS%1"", _forEachIndex];  " \n "        [_x, ""OFF""] remoteExec [""switchLight"", 0, _ticket];  " \n "    } forEach nearestObjects [markerPos _marker, [], _distance];  " \n "    _unit setVariable [""poweredOn"", false, true];  " \n "}]; ";
				name="xfmr_Kavala";
