5, 0.4, 0.3], " \n "             [0.6, 0.5, 0.4, 0]], " \n "            [1,0.5,0.25], " \n "            0.1, " \n "            1, " \n "            """", " \n "            """", " \n "            _dEffect, " \n "            0, " \n "            true, " \n "            0.1 " \n "        ]; " \n "        sleep (2 * _scale); " \n "        deleteVehicle _dEffect; " \n "    }; " \n "}; " \n " " \n "fnc_createFire = { " \n "    params [""_position""]; " \n "    if (activeFireCount >= 5) exitWith {}; " \n "    activeFireCount = activeFireCount + 1; " \n "     " \n "    private _groundPos = _position findEmptyPosition [0, 0.1]; " \n "    if (_groundPos isEqualTo []) then {_groundPos = _position}; " \n "     " \n "    private _fire = ""#particlesource"" createVehicleLocal _groundPos; " \n "    private _smoke = ""#particlesource"" createVehicleLocal _groundPos; " \n "     " \n "    _fire setParticleParams [ " \n "        [""\A3\data_f\ParticleEffects\Universal\Universal"", 16, 1, 12, 0], " \n "        """", " \n "        ""Billboard"", " \n "        1, " \n "        1, " \n "        [0, 0, 0], " \n "        [0, 0, 0.5], " \n "        1, 1.275, 1, 0, " \n "        [0.5, 0.7, 0.5], " \n "        [[1, 1, 1, -10], [1, 1, 1, -8], [1, 1, 1, -6], [1, 1, 1, -0.5], [1, 1, 1, 0]], " \n "        [0.5], " \n "        1, " \n "        1, " \n "        """", " \n "        """", " \n "        _fire " \n "    ]; " \n "     " \n "    _smoke setParticleParams [ " \n "        [""\A3\data_f\ParticleEffects\Universal\Universal"", 16, 7, 48, 1], " \n "        """", " \n "        ""Billboard"", " \n "        1, " \n "        10, " \n "        [0, 0, 0], " \n "        [0, 0, 2], " \n "        1, 1.275, 1, 0.025, " \n "        [1, 3, 5], " \n "        [[0.1, 0.1, 0.1, 0.8], [0.2, 0.2, 0.2, 0.45], [0.3, 0.3, 0.3, 0.2], [0.4, 0.4, 0.4, 0]], " \n "        [0.1], " \n "        1, " \n "        1, " \n "        """", " \n "        """", " \n "        _smoke " \n "    ]; " \n "     " \n "    _fire setDropInterval 0.02; " \n "    _smoke setDropInterval 0.05; " \n "     " \n "    [_fire, _smoke, _groundPos] spawn { " \n "        params [""_fireEffect"", ""_smokeEffect"", ""_pos""]; " \n "        sleep 300; " \n "         " \n "        if (random 1 < 0.05 && activeFireCount < 5) then { " \n "            [_pos] spawn fnc_createFire; " \n "        }; " \n "         " \n "        activeFireCount = activeFireCount - 1; " \n "        deleteVehicle _fireEffect; " \n "        deleteVehicle _smokeEffect; " \n "    }; " \n "}; " \n " " \n "addMissionEventHandler [""ProjectileCreated"", { " \n "    params [""_projectile""]; " \n "    _projectile addEventHandler [""Explode"", { " \n "        params [""_projectile"", ""_pos""]; " \n "         " \n "        private _isGrenade = _projectile isKindOf ""GrenadeBase""; " \n "        private _radius = if (_isGrenade) then {3} else {20}; " \n "        private _effectSize = if (_isGrenade) then {0.1} else {1}; " \n "         " \n "        private _nearBuildings = nearestObjects [_pos, [""Building""], _radius]; " \n "         " \n "        { " \n "            private _building = _x; " \n "            private _positions = _building buildingPos -1; " \n "            if (count _positions > 0) then { " \n "                private _nearestPos = selectRandom _positions; " \n "                [_nearestPos, random 360, true, _effectSize] spawn fnc_createPositionalDust; " \n "            }; " \n "            [getPosATL _building, random 360, false, _effectSize] spawn fnc_createPositionalDust; " \n "             " \n "            if (random 1 < 0.1) then { " \n "                [_pos] spawn fnc_createFire; " \n "            }; " \n "        } forEach _nearBuildings; " \n "    }]; " \n "}];";
