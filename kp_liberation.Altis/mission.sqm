					class Attributes
					{
						onActivation="independent setFriend [west, 0];  " \n "east setFriend [independent, 0];  " \n "independent setFriend [east, 0];  " \n "west setFriend [east, 0];  " \n "east setFriend [west, 0];  " \n "  " \n "{  " \n "    _x setFriend [civilian, 0];  " \n "    civilian setFriend [_x, 0];  " \n "} forEach [west, east, independent];  " \n "  " \n "[] spawn {  " \n "    while {true} do {  " \n "        {  " \n "            if (side _x != civilian) then {  " \n "                private _targets = _x nearTargets 300;  " \n "                private _civilianTargets = _targets select {  " \n "                    private _target = _x select 4;  " \n "                    alive (_target) &&  " \n "                    side (_target) == civilian &&  " \n "                    (_target isKindOf ""CAManBase"")  " \n "                };  " \n " " \n "                if !(_civilianTargets isEqualTo []) then {  " \n "                    private _target = selectRandom _civilianTargets select 4;  " \n "                    _x doWatch _target;  " \n "                    _x doTarget _target;  " \n "                    _x doFire _target;  " \n "                };  " \n "            };  " \n " " \n "            if (side _x == civilian) then {  " \n "                _x disableAI ""FSM"";  " \n "                _x setBehaviour ""SAFE"";  " \n "                _x setCombatMode ""RED"";  " \n "                _x addRating 10000;  " \n "            };  " \n "        } forEach allUnits;  " \n " " \n "        sleep 240;  " \n "    };  " \n "};  " \n " " \n "[] spawn {  " \n "    while {true} do {  " \n "        _vehicles = vehicles;  " \n "        {  " \n "            if (typeOf _x in [""I_MBT_03_cannon_F"", ""O_MBT_02_cannon_F"", ""B_MBT_01_cannon_F""]) then {  " \n "                _x limitSpeed 60;  " \n "            };  " \n "        } forEach _vehicles;  " \n "        sleep 10;  " \n "    };  " \n "};  " \n " " \n "_markerName = ""dave"";  " \n "_markerPos = getMarkerPos _markerName;  " \n "_buildings = nearestObjects [_markerPos, [""House""], 1000];  " \n "{  " \n "    _x setDamage 0.75;  " \n "    _x allowDamage false;  " \n "} forEach _buildings;  " \n " " \n "[true,5,true,true,15,1,true,[""Kingsmen"",""B_Heli_Transport_01_camo_F""]] execVM ""WerthlesHeadless.sqf"";  " \n " " \n "enableSaving [false,false]; " \n " " \n "if (hasInterface) then {  " \n "    addMissionEventHandler [""EntityKilled"", {  " \n "        params [""_killed"", ""_killer"", ""_instigator""];  " \n "        if (isNull _instigator) then {  " \n "            _instigator = _killer;  " \n "        };  " \n " " \n "        if (isPlayer _killer && _killed isKindOf ""CAManBase"") then {  " \n "            private _distance = _killer distance2D _killed;  " \n "            private _killed_Name = """";  " \n " " \n "            if (!(isPlayer _killed)) then {  " \n "                _killed_Name = getText(configFile >> ""CfgVehicles"" >> format[""%1"", typeOf _killed] >> ""Displayname"");  " \n "            } else {  " \n "                _killed_Name = name _killed;  " \n "            };  " \n " " \n "            _kill_HUD = format[""<t size='1'><t color='#FF0000'>%2</t> eliminated </t><t color='#FF0000'>%4</t> <t color='#FF0000'>%5m</t>"", name _killer, _killed_Name, """", floor _distance];  " \n "            [_kill_HUD, 0.5, 0.8, 2, 0, 0, 7017] remoteExec [""bis_fnc_dynamicText"", 0];  " \n " " \n "            playSound ""Killfeed_notification"";  " \n "        };  " \n "    }];  " \n "};   " \n "setTimeMultiplier 0; " \n "setAccTime 0.80;  " \n " " \n "if (isNil ""globalMarkers"") then {  " \n "    globalMarkers = [];  " \n "};  " \n " " \n "if (isNil ""territoryControl"") then {  " \n "    territoryControl = createHashMap;  " \n "};  " \n " " \n "private _gridSize = 350;  " \n "private _mapSize = worldSize;  " \n "private _detectionRadius = _gridSize * 1.5;  " \n " " \n "for ""_x"" from 0 to floor(_mapSize / _gridSize) do {  " \n "    for ""_y"" from 0 to floor(_mapSize / _gridSize) do {  " \n "        private _markerName = format [""territory_%1_%2"", _x, _y];  " \n "        private _pos = [(_x * _gridSize), (_y * _gridSize)];  " \n "          " \n "        private _marker = createMarkerLocal [_markerName, _pos];  " \n "        _marker setMarkerShape ""RECTANGLE"";  " \n "        _marker setMarkerBrush ""DiagGrid"";  " \n "        _marker setMarkerSize [_gridSize/2, _gridSize/2];  " \n "        _marker setMarkerColor ""ColorGrey"";  " \n "        _marker setMarkerAlpha 0;  " \n "        globalMarkers pushBack [_marker, _pos];  " \n "        territoryControl set [_marker, ""ColorGrey""];  " \n "    };  " \n "};  " \n " " \n "[_detectionRadius] spawn {  " \n "    params [""_detectionRadius""];  " \n "      " \n "    while {true} do {  " \n "        _units = [];  " \n "        {  " \n "            if (((vehicle _x) isKindOf ""Land"") || ((vehicle _x) isKindOf ""CAManBase"")) then {  " \n "                if !(vehicle _x isKindOf ""Air"") then {  " \n "                    if !(typeOf _x in [""B_Pilot_F"", ""O_Pilot_F"", ""I_Pilot_F""]) then {  " \n "                        _units pushBack [_x, side _x, getPosWorld _x];  " \n "                    };  " \n "                };  " \n "            };  " \n "        } forEach allUnits;  " \n "          " \n "        {  " \n "            _markerData = _x;  " \n "            _marker = _markerData select 0;  " \n "            _pos = _markerData select 1;  " \n "              " \n "            private _blufor = 0;  " \n "            private _opfor = 0;  " \n "            private _independent = 0;  " \n "            private _civilian = 0;  " \n "              " \n "            {  " \n "                if ((_x select 2) distance2D _pos < _detectionRadius) then {  " \n "                    switch (_x select 1) do {  " \n "                        case west: {_blufor = _blufor + 1};  " \n "                        case east: {_opfor = _opfor + 1};  " \n "                        case resistance: {_independent = _independent + 1};  " \n "                        case civilian: {_civilian = _civilian + 1};  " \n "                    };  " \n "                };  " \n "            } forEach _units;  " \n "              " \n "            private _currentControl = territoryControl get _marker;  " \n "              " \n "            private _color = switch (true) do {  " \n "                case (_blufor > 0 && _opfor == 0 && _independent == 0): {""ColorBlue""};  " \n "                case (_opfor > 0 && _blufor == 0 && _independent == 0): {""ColorRed""};  " \n "                case (_independent > 0 && _blufor == 0 && _opfor == 0): {""ColorGreen""};  " \n "                case (_civilian > 0 && _blufor == 0 && _opfor == 0 && _independent == 0): {""ColorCIV""};  " \n "                case (_blufor > 0 || _opfor > 0 || _independent > 0): {""ColorUNKNOWN""};  " \n "                default {_currentControl};  " \n "            };  " \n "              " \n "            if (_color != _currentControl) then {  " \n "                if (_color == ""ColorGrey"") then {  " \n "                    _marker setMarkerAlpha 0;  " \n "                } else {  " \n "                    _marker setMarkerAlpha 0.7;  " \n "                    _marker setMarkerColor _color;  " \n "                };  " \n "                territoryControl set [_marker, _color];  " \n "            };  " \n "        } forEach globalMarkers;  " \n "          " \n "        sleep 3;  " \n "    };  " \n "};";
